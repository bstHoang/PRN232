@model List<Project_FontEnd.Models.CategoryModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Quản Lý Danh Mục";
}

<h1>Quản Lý Danh Mục</h1>

<!-- Search Form -->
<form asp-action="Menu" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control" placeholder="Tìm kiếm theo tên danh mục" value="@ViewData["CurrentFilter"]" />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>
</form>

<!-- Create Button -->
<p>
    <a asp-action="Create" class="btn btn-success">Tạo Danh Mục Mới</a>
</p>

<!-- Categories Table -->
<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Tên</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Id</td>
                <td>@category.Name</td>
                <td>
                    <a asp-action="Update" asp-route-id="@category.Id" class="btn btn-primary btn-sm">Cập nhật</a>
                    <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa danh mục này?')">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Display Success/Error Message -->
@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}

@section Scripts {
    <script>
        // Optional: Add any client-side validation or enhancements
    </script>
}