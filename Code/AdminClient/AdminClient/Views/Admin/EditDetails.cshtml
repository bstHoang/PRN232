@model AdminClient.Models.UpdateDetailsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<h2>Chỉnh sửa thông tin nhân viên</h2>
<form method="post">
    <div>
        <label>Email</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>
        <label>Mật khẩu</label>
        <input asp-for="Password" type="password" placeholder="**************" />
        <span asp-validation-for="Password"></span>
    </div>
    <div>
        <label>Vai trò</label>
        <select asp-for="Role">
            <option value="">Chọn vai trò</option>
            @if (ViewBag.Roles != null && ViewBag.Roles.Count > 0)
            {
                @foreach (var role in ViewBag.Roles)
                {
                    <option value="@role" selected="@(role == Model.Role)">@role</option>
                }
            }
        </select>
        <span asp-validation-for="Role"></span>
    </div>
    <div>
        <label>Khóa tài khoản</label>
        <input asp-for="IsDisabled" type="checkbox" checked="@Model.IsDisabled" />
    </div>
    <button type="submit">Lưu</button>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="text-danger">@Html.ValidationSummary()</div>
    }
</form>