@model AdminClient.Models.UpdateDetailsModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<h2>Chỉnh sửa thông tin nhân viên</h2>
<p>Model.RoleName = @Model.RoleName</p>
<form method="post">
    <div>
        <label>Email</label>
        <input asp-for="Email" />
        <span asp-validation-for="Email"></span>
    </div>
    <div>
        <label>Mật khẩu</label>
        <input asp-for="Password" type="password" placeholder="**************" />
        <span asp-validation-for="Password"></span>
    </div>
    <div>
        <label>Vai trò</label>
        <select asp-for="RoleName" class="form-control">
            <option value="">Chọn vai trò</option>
            @foreach (var role in ViewBag.Roles as List<string>)
            {
                <option value="@role" selected="@(role == Model.RoleName ? "selected" : null)">
                    @role
                </option>
            }
        </select>
        <span asp-validation-for="RoleName" class="text-danger"></span>
    </div>
    <div>
        <label>Khóa tài khoản</label>
        <input asp-for="IsDisabled" type="checkbox" checked="@Model.IsDisabled" />
    </div>
    <button type="submit">Lưu</button>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="text-danger">@Html.ValidationSummary()</div>
    }
</form>