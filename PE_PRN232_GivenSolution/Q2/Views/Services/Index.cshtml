@model List<Q2.Models.ServiceViewModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Danh sách dịch vụ";
}

<h1>Danh sách dịch vụ</h1>
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchName" class="form-control" placeholder="Tìm theo tên nhân viên..." value="@ViewBag.SearchName" />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

@if (Model?.Any() == true)
{
    <table class="table table-bordered" border="1" style="border-collapse: collapse;">
        <thead class="thead-dark">
            <tr>
                <th>ID</th>
                <th>Phòng</th>
                <th>Tháng</th>
                <th>Năm</th>
                <th>Loại phí</th>
                <th>Số tiền</th>
                <th>Ngày thanh toán</th>
                <th>Nhân viên</th>
                <th>Chi tiết phòng</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var service in Model)
            {
                <tr>
                    <td>@service.Id</td>
                    <td>@service.RoomTitle</td>
                    <td>@service.Month</td>
                    <td>@service.Year</td>
                    <td>@service.FeeType</td>
                    <td>@service.Amount.ToString("N0")</td>
                    <td>@service.PaymentDate</td>
                    <td>@(service.Employee != null ? service.Employee.Name : "N/A")</td>
                    <td>@(service.Room != null ? $"{service.Room.Description} (Tầng {service.Room.Floor}, {service.Room.Square} m²)" : "N/A")</td>
                </tr>
            }
            
        </tbody>
    </table>
}
else
{
    <p>Không có dữ liệu dịch vụ.</p>
}

