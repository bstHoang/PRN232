<Window x:Class="ClientHR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClientHR"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Danh sách nhân viên -->
        <StackPanel Grid.Column="0" Margin="10">
            <Label Content="Lọc theo phòng ban:" />
            <StackPanel>
                <RadioButton Content="Tất cả" IsChecked="True" GroupName="DepartmentFilter" Checked="RadioButton_Checked" Tag="All" />
                <ItemsControl Name="icDepartments">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Name}" Tag="{Binding Id}" GroupName="DepartmentFilter" Checked="RadioButton_Checked" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <DataGrid Name="dgEmployees" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="dgEmployees_SelectionChanged" Margin="0,10,0,0" />
        </StackPanel>

        <!-- Chi tiết nhân viên -->
        <StackPanel Grid.Column="1" Margin="10">
            <Label Content="Chi tiết nhân viên" FontWeight="Bold" />
            <TextBox Name="txtId" IsReadOnly="True" Margin="0,5" />
            <TextBox Name="txtUserName" Margin="0,5" />
            <TextBox Name="txtName" Margin="0,5" />
            <ComboBox Name="cmbDepartment" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,5" />
            <ComboBox Name="cmbPosition" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,5" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Update" Click="UpdateEmployee_Click" Width="80" />
                <Button Content="Create" Click="CreateEmployee_Click" Width="80" Margin="10,0,0,0" />
                <Button Content="Delete" Click="DeleteEmployee_Click" Width="80" Margin="10,0,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
