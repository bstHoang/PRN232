@model List<Project_FontEnd.Models.NewsModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<h2>My News</h2>
<div class="row">
    @foreach (var news in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">
                        @news.Title
                        @if (news.Disable)
                        {
                            <span class="text-danger">(disabled)</span>
                        }
                    </h5>
                    <p class="card-text">@news.Description</p>

                    @if (news.Disable)
                    {
                        <!-- Nút xem bị disable -->
                        <button class="btn btn-secondary" onclick="showDisabledAlert()">Read More</button>
                    }
                    else
                    {
                        <a asp-controller="News" asp-action="Details" asp-route-id="@news.Id" class="btn btn-primary">Read More</a>
                    }

                    <a asp-controller="News" asp-action="Update" asp-route-id="@news.Id" class="btn btn-warning">Edit</a>
                    <a asp-controller="News" asp-action="Delete" asp-route-id="@news.Id" class="btn btn-danger">Delete</a>
                </div>
            </div>
        </div>
    }
</div>

<!-- Popup alert -->
@section Scripts {
    <script>
        function showDisabledAlert() {
            alert("News has been disabled.");
        }
    </script>
}
