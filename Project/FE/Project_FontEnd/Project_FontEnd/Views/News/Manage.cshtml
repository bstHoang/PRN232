@model List<Project_FontEnd.Models.NewsModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "News Management";
    var categories = ViewBag.Categories as List<Project_FontEnd.Models.CategoryModel>;
    var topTags = ViewBag.TopTags as List<Project_FontEnd.Models.TagModel1>;
}

<div class="container mt-4">
    <h2>News Management</h2>

    <!-- Form lọc -->
    <form class="row g-2 mb-4" method="get" asp-controller="News" asp-action="Manage">
        <div class="col-md-4">
            <input class="form-control" type="search" name="title" placeholder="Search news..." value="@Context.Request.Query["title"]" />
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select">
                <option value="">-- All Categories --</option>
                @if (categories != null)
                {
                    foreach (var cat in categories)
                    {
                        <option value="@cat.Id" selected="@(Context.Request.Query["categoryId"] == cat.Id.ToString())">@cat.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="tagId" class="form-select">
                <option value="">-- All Tags --</option>
                @if (topTags != null)
                {
                    foreach (var tag in topTags)
                    {
                        <option value="@tag.TagId" selected="@(Context.Request.Query["tagId"] == tag.TagId.ToString())">@tag.TagName (@tag.Count)</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-success w-100" type="submit">Filter</button>
        </div>
    </form>

    <div class="row">

        <!-- Cột giữa: Bảng tin tức -->
        <div class="col-md-10">
            @if (Model == null || !Model.Any())
            {
                <p class="text-muted">No news found.</p>
            }
            else
            {
                <table class="table table-bordered table-striped">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Title</th>
                            <th>Description</th>
                            <th>Created At</th>
                            <th>Created By</th>
                            <th>Disabled</th>
                            <th style="width: 160px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var news in Model)
                        {
                            <tr>
                                <td>@news.Id</td>
                                <td>@news.Title</td>
                                <td>@news.Description</td>
                                <td>@news.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@news.CreateBy - @news.CreatedByName</td>
                                <td>@(news.Disable ? "Yes" : "No")</td>
                                <td>
                                    <a asp-controller="News" asp-action="ManageDetail" asp-route-id="@news.Id" class="btn btn-sm btn-warning">Update</a>
                                    <a asp-controller="News" asp-action="DeleteManage" asp-route-id="@news.Id" class="btn btn-sm btn-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

       
    </div>
</div>