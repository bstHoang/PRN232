@model List<Project_FontEnd.Models.NewsModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "News Management";
}

<h2>News Management</h2>

<form class="d-flex ms-auto" asp-controller="News" asp-action="Manage" method="get">
    <input class="form-control me-2" type="search" name="title" placeholder="Search news..." aria-label="Search" />
    <button class="btn btn-outline-success" type="submit">Search</button>
</form>
<br></br>
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Title</th>
            <th>Description</th>
            <th>Created At</th>
            <th>Created By</th>
            <th>Disabled</th>
            <th style="width: 160px;">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var news in Model)
        {
            <tr>
                <td>@news.Id</td>
                <td>@news.Title</td>
                <td>@news.Description</td>
                <td>@news.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@news.CreatedByName</td>
                <td>@(news.Disable ? "Yes" : "No")</td>
                <td>
                    <a asp-controller="News" asp-action="ManageDetail" asp-route-id="@news.Id" class="btn btn-sm btn-warning">Update</a>
                    <a asp-controller="News" asp-action="DeleteManage" asp-route-id="@news.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
