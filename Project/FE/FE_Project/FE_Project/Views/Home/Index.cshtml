@model List<FE_Project.Models.NewsModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<h2>All News</h2>
@if (!string.IsNullOrEmpty(ViewBag.SearchTitle))
{
    <p>Search results for: <strong>@ViewBag.SearchTitle</strong></p>
}
@if (Model == null || !Model.Any())
{
    <p>No news found.</p>
}
else
{
    <div class="row">
        @foreach (var news in Model)
        {
            <div class="col-md-4 mb-3">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@news.Title</h5>
                        <p class="card-text">@news.Description</p>
                        <p><strong>Created At:</strong> @news.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                        <p><strong>Created By:</strong> @news.CreateBy</p>
                        <a asp-controller="News" asp-action="Details" asp-route-id="@news.Id" class="btn btn-primary">Read More</a>
                        @if (User.IsInRole("JOURNALIST") || User.IsInRole("MANAGER"))
                        {
                            <a asp-controller="News" asp-action="Update" asp-route-id="@news.Id" class="btn btn-warning">Edit</a>
                            <a asp-controller="News" asp-action="Delete" asp-route-id="@news.Id" class="btn btn-danger">Delete</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}