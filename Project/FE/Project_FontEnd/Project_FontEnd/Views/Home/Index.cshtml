@model List<Project_FontEnd.Models.NewsModel>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Security.Claims

<div class="container mt-4">
    <div class="row mb-3">
        <div class="col-md-9">
            <h2 class="mb-3">All News</h2>
            @if (!string.IsNullOrEmpty(ViewBag.SearchTitle))
            {
                <p class="text-muted">Search results for: <strong>@ViewBag.SearchTitle</strong></p>
            }
            @if (ViewBag.SelectedTagId != null)
            {
                <p class="text-muted">News for tag: <strong>@ViewBag.SelectedTagName</strong></p>
            }
        </div>
        <div class="col-md-3">
            <form class="input-group" asp-controller="Home" asp-action="Index" method="get">
                <input class="form-control" type="search" name="title" placeholder="Search news..." aria-label="Search" />
                <button class="btn btn-outline-success" type="submit">Search</button>
            </form>
        </div>
    </div>

    <div class="row">
        <!-- Cột trái: Danh mục -->
        <div class="col-md-2">
            <h5>Categories</h5>
            <ul class="list-group">
                <!-- Mục "All" để hiển thị tất cả tin tức -->
                <li class="list-group-item @(ViewBag.SelectedCategoryId == null ? "active" : "")">
                    <a asp-controller="Home" asp-action="Index"
                       class="text-decoration-none @(ViewBag.SelectedCategoryId == null ? "text-white" : "")">
                        All
                    </a>
                </li>

                <!-- Các danh mục cụ thể -->
                @foreach (var category in ViewBag.Categories as List<Project_FontEnd.Models.CategoryModel>)
                {
                    <li class="list-group-item @(ViewBag.SelectedCategoryId == category.Id ? "active" : "")">
                        <a asp-controller="Home" asp-action="NewsByCategory" asp-route-id="@category.Id"
                           class="text-decoration-none @(ViewBag.SelectedCategoryId == category.Id ? "text-white" : "")">
                            @category.Name
                        </a>
                    </li>
                }
            </ul>
        </div>

        <!-- Cột giữa: Tin tức -->
        <div class="col-md-8">
            @if (Model == null || !Model.Any())
            {
                <p class="text-muted">No news found.</p>
            }
            else
            {
                <div class="row">
                    @foreach (var news in Model)
                    {
                        <div class="col-md-6 col-lg-4 mb-4">
                            <div class="card h-100 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title text-truncate">@news.Title</h5>
                                    <p class="card-text">@news.Description</p>
                                    <p class="mb-1"><small><strong>Created At:</strong> @news.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></p>
                                    <p class="mb-3"><small><strong>Created By:</strong> @news.CreatedByName</small></p>

                                    <div class="mt-auto">
                                        <a asp-controller="News" asp-action="Details" asp-route-id="@news.Id" class="btn btn-sm btn-primary me-2">Read More</a>
                                        @{
                                            var userId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
                                            if (User.IsInRole("MANAGER"))
                                            {
                                                <a asp-controller="News" asp-action="Update" asp-route-id="@news.Id" class="btn btn-sm btn-warning me-1">Edit</a>
                                                <a asp-controller="News" asp-action="Delete" asp-route-id="@news.Id" class="btn btn-sm btn-danger">Delete</a>
                                            }
                                            else if (User.IsInRole("JOURNALIST") && news.CreateBy.ToString() == userId)
                                            {
                                                <a asp-controller="News" asp-action="Update" asp-route-id="@news.Id" class="btn btn-sm btn-warning me-1">Edit</a>
                                                <a asp-controller="News" asp-action="Delete" asp-route-id="@news.Id" class="btn btn-sm btn-danger">Delete</a>
                                            }
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Cột phải: Tag -->
        <div class="col-md-2">
            <h5>Top Tags</h5>
            <ul class="list-group">
                @foreach (var tag in ViewBag.TopTags as List<Project_FontEnd.Models.TagModel1>)
                {
                    <li class="list-group-item @(ViewBag.SelectedTagId == tag.TagId ? "active" : "")">
                        <a asp-controller="Home" asp-action="NewsByTag" asp-route-id="@tag.TagId"
                           class="text-decoration-none @(ViewBag.SelectedTagId == tag.TagId ? "text-white" : "")">
                            @tag.TagName (@tag.Count)
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</div>