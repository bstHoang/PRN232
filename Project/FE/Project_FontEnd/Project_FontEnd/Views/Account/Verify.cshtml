@model Project_FontEnd.Models.VerifyModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<h2>Verify Email</h2>
<form asp-action="Verify" method="post">
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input asp-for="Email" class="form-control" value="@Context.Session.GetString("Email")" readonly />
    </div>
    <div class="mb-3">
        <label class="form-label">Verification Code</label>
        <input asp-for="Code" class="form-control" />
        <span asp-validation-for="Code" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <button type="submit" class="btn btn-primary">Verify</button>
        <button type="button" id="resendButton" class="btn btn-secondary ms-2" onclick="resendCode()">Resend Code</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function resendCode() {
            const button = document.getElementById('resendButton');

            // Vô hiệu hóa nút
            button.disabled = true;
            button.innerText = 'Resend Code (10s)';

            // Gửi request đến action ResendCode
            fetch('/Account/ResendCode', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            })
                .then(response => response.json())
                .then(data => {
                    alert(data.success ? data.message : 'Error: ' + data.message);
                })
                .catch(error => {
                    alert('Error resending code: ' + error.message);
                });

            // Đếm ngược 10 giây
            let countdown = 10;
            const interval = setInterval(() => {
                countdown--;
                button.innerText = `Resend Code (${countdown}s)`;
                if (countdown <= 0) {
                    clearInterval(interval);
                    button.disabled = false;
                    button.innerText = 'Resend Code';
                }
            }, 1000);
        }
    </script>
}